# ===========================================================================
# Plantilla del entorno de desarrollo (plan R-1). NUNCA con claves reales.
# ---------------------------------------------------------------------------
# Copiarla a backend/.env.dev y completar. backend/.env.dev queda fuera de
# git por la regla `.env.*`; esta plantilla SI se versiona.
#
# Uso: `npm run dev:*` desde backend/ (ver backend/package.json). Los scripts
# lanzan node con --env-file=.env.dev y el cargador src/config/entorno.js
# lee el archivo de AEXIA_ENV_FILE (por defecto backend/.env). En
# AEXIA_ENTORNO=dev el cargador ABORTA si ve senales de produccion:
# MySQL 3306, host no local, app :3000, central si_central/aexia_central,
# usuarios sin 'dev' o credenciales de Cloudinary con MEDIA_MODO=deshabilitado.
# ===========================================================================

# --- Dev: identificacion del entorno (ver guardas en src/config/entorno.js) ---
AEXIA_ENTORNO=dev
NODE_ENV=development

# --- Servidor ---
PORT=3100
HOST=127.0.0.1

# --- MySQL DEV (instancia propia, puerto 3307, enlaza solo a loopback) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=aexia_dev_app
DB_PASSWORD=            # clave de dev, local
DB_CENTRAL_NAME=aexia_dev_central
PREFIJO_TENANT=aexia_dev_tenant_
DB_ADMIN_USER=aexia_dev_admin
DB_ADMIN_PASSWORD=      # clave de dev, local

# DB_NAME NO se define en dev (es legado de la empresa #1 en prod).

# --- Seguridad (claves DISTINTAS de prod) ---
JWT_SECRET=             # generar una nueva, solo para dev (openssl rand -base64 32)
CREDENCIALES_KEY=       # generar una nueva para dev

# --- Multimedia: apagado en dev ---
MEDIA_MODO=deshabilitado
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Backups: sin cron en dev ---
BACKUP_ACTIVO=false
BACKUP_OFFSITE_DIR=

# --- Herramientas (reusar binarios; misma maquina, otro -P) ---
MYSQLDUMP_PATH=         # ruta del mysqldump (de prod o de la instancia dev)
MYSQL_PATH=             # ruta del cliente mysql

# --- Marca: opcional, para distinguir la pestana de dev ---
PLATAFORMA_NOMBRE=Aexia DEV