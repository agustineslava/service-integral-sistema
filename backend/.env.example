# ===========================================================================
# PLANTILLA DE CONFIGURACION - copiar a .env y completar
#   copy .env.example .env
#
# NUNCA subir el .env real. Este archivo no lleva valores reales.
# ===========================================================================

# --- Servidor ---
PORT=3000
# Interface donde escucha la app. Por defecto 0.0.0.0 (todas) para no cortar
# instalaciones existentes. En PRODUCCION detras del tunel de Cloudflare se
# recomienda HOST=127.0.0.1: el tunel conecta por localhost y asi el :3000 no
# queda alcanzable sin pasar por Cloudflare (docs/plan-salida-aexia-com-ar.md).
HOST=0.0.0.0
# Saltos de proxy en los que confiar para la IP del cliente (Cloudflare
# Tunnel = 1). No lo subas sin saber por que: mas saltos = mas cabeceras
# X-Forwarded-* que el servidor toma como ciertas. Por defecto 1.
TRUST_PROXY=1

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=aexia_app
DB_PASSWORD=
# Nombre de la base del taller. Los nombres de base se normalizan a minuscula
# (MySQL en Windows ya los guarda asi; en Linux distinguiria mayusculas).
# Es la base de la empresa #1 legada (Service Integral), NO la plataforma.
DB_NAME=ServiceIntegralsistema

# Base CENTRAL: el registro de todas las empresas, los logins y los modulos
# contratados. NO pertenece a ninguna empresa. Se crea con: npm run f1:setup
DB_CENTRAL_NAME=aexia_central

# Prefijo de las bases de cada empresa. De aca salen el nombre que arma el alta
# y el patron del GRANT (tiene que terminar en "_"). Si se deja vacio, el
# default es `si_tenant_`, para no romper instalaciones existentes. Las
# instalaciones nuevas usan `aexia_tenant_`.
PREFIJO_TENANT=aexia_tenant_

# Usuario ADMINISTRADOR de MySQL. Solo lo usa el alta de empresas (F6)
# y las restauraciones de verificacion. NO lo usa la app en runtime.
# Nuevas instalaciones: aexia_admin. Si se deja vacio, el default es
# `si_tenant_admin` (comportamiento historico).
DB_ADMIN_USER=aexia_admin
DB_ADMIN_PASSWORD=

# --- Seguridad ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Clave para CIFRAR en reposo los secretos por empresa (hoy: el api_secret de
# Cloudinary de cada una). 32 bytes en base64. Generar con:
#   openssl rand -base64 32
# NO la cambies una vez cargadas cuentas: si se pierde, los api_secret guardados
# quedan ilegibles y hay que volver a cargar cada cuenta.
CREDENCIALES_KEY=

# --- Usuario administrador inicial: ELIMINADO EN F2 ---
# Antes el servidor creaba este usuario en cada arranque si no lo encontraba.
# Con varias empresas eso ya no aplica: los usuarios viven en la base central
# (usuarios_globales) y se crean desde la app.
# ADMIN_EMAIL_INICIAL y ADMIN_PASSWORD_INICIAL YA NO SE LEEN. Si las tenés en
# tu .env no molestan, pero se pueden borrar.

# --- Multimedia (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Herramientas de sistema ---
# Ruta completa al ejecutable de mysqldump (MySQL Workbench o Server)
MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Workbench 8.0 CE\mysqldump.exe
# Ruta completa al cliente mysql (importador de restauraciones).
# Si se deja vacio se deduce de MYSQLDUMP_PATH y, si no, se busca en las
# instalaciones tipicas de MySQL Server.
MYSQL_PATH=

# --- Backups ---
# Carpeta externa para copia offsite (unidad de red, disco externo, etc.)
# Si esta vacia, solo se hace el backup local.
BACKUP_OFFSITE_DIR=

# Retencion local en dias: en cada corrida se borran los .sql mas viejos que
# esto, de TODAS las bases. Por defecto (si se deja vacio): 30 dias.
BACKUP_DIAS_RETENCION=30

# Usuario de MySQL de SOLO LECTURA para los dumps multi-base (central + todas
# las empresas). Si se deja vacio, los dumps usan DB_USER (el de la app).
#
# Permisos minimos que necesita (se otorgan una vez por base; con backticks si
# el nombre lleva mayusculas). Crearlo como root o aexia_admin (el admin de
# bases; por defecto si_tenant_admin):
#
#   CREATE USER 'backup'@'localhost' IDENTIFIED BY 'una-clave-fuerte';
#   GRANT SELECT, SHOW VIEW, TRIGGER ON `aexia_central`.* TO 'backup'@'localhost';
#   GRANT SELECT, SHOW VIEW, TRIGGER ON `aexia_tenant\_%`.* TO 'backup'@'localhost';
#   GRANT SELECT, SHOW VIEW, TRIGGER ON `ServiceIntegralsistema`.* TO 'backup'@'localhost';
#   -- (y un GRANT por cada base fuera del patron, para empezar la legada)
#
# Nota: si la instalacion conserva el prefijo viejo, usar `si_central` y
# `si_tenant\_%` (o el valor de PREFIJO_TENANT que tenga el .env).
#
# Por que esos y no otros: mysqldump corre con --single-transaction (snapshot,
# no necesita LOCK TABLES ni RELOAD), --no-tablespaces (no necesita PROCESS),
# sin --routines ni --events (no necesita EVENT ni ROUTINE) y con --triggers
# (necesita TRIGGER). SHOW VIEW cubre las vistas si algun dia existen.
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=

# --- Marca de la PLATAFORMA (Aexia) ---
# Es la que se ve cuando la pantalla NO es de ninguna empresa: el login antes
# de escribir el correo y el panel del superadmin. La marca de cada empresa
# vive en la base central (fila de `empresas`), no aca.
PLATAFORMA_NOMBRE=Aexia
PLATAFORMA_SUBTITULO=Gestion para talleres y comercios
PLATAFORMA_LOGO=logos/aexia.svg

# --- Marca de la empresa #1 legada (solo para importar/sembrar) ---
# La usan `importar-empresa` y `datos-empresa --sembrar` para copiar el nombre,
# el subtitulo y el logo del .env a la fila de la empresa. NO es la marca de
# runtime de la plataforma: esa es PLATAFORMA_*.
COMERCIO_NOMBRE=Service Integral
COMERCIO_SUBTITULO=Gestion de Stock y Taller
COMERCIO_LOGO=logos/logo.jpg
